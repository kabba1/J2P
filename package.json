    "test:pairs": "node --test tests/async-storage-pair-repository.test.cjs",
    "test:matched-after": "node --test tests/matched-after-service.test.cjs",
    "test:generated-assets": "node --test tests/app-config.test.cjs tests/eas-config.test.cjs tests/async-storage-generated-asset-repository.test.cjs tests/before-after-post-renderer.test.cjs tests/generated-asset-config.test.cjs tests/generated-asset-export-service.test.cjs tests/generated-asset-storage.test.cjs tests/generated-asset-service.test.cjs tests/keyed-operation-queue.test.cjs",
    "test:polish": "node --test tests/field-usability-polish.test.cjs",
    "test:job-dashboard": "node --test tests/job-dashboard-presentation.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
